{
  "name": "rachel-english-dashboard",
  "version": "0.1.0",
  "description": "공부방 진도 현황판 (읽기 전용 전체 화면 데스크톱 앱)",
  "author": "ecarusblue",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "electron scripts/make-icon.js",
    "dist": "npm run icon && npx --yes electron-builder@26.18.0 --win"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "electron": "^45.0.0"
  },
  "build": {
    "appId": "com.ecarusblue.rachel-english-dashboard",
    "productName": "Rachel English 현황판",
    "executableName": "RachelEnglishDashboard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/pretendard/**",
      "node_modules/pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css",
      "node_modules/pretendard/dist/web/variable/woff2-dynamic-subset/**"
    ],
    "extraResources": [
      {
        "from": "config.local.json",
        "to": "config.local.json"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RachelEnglish-Dashboard-Setup-${version}.${ext}",
      "shortcutName": "Rachel English 현황판"
    },
    "portable": {
      "artifactName": "RachelEnglish-Dashboard-${version}-portable.${ext}"
    }
  }
}
